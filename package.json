{
  "name": "file-upload-monorepo",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "build": "bun run --filter '*' build",
    "build:backend": "bun run --filter backend build",
    "build:frontend": "bun run --filter frontend build",
    "start": "bun run --filter backend start",
    "start:backend": "bun run --filter backend start",
    "start:frontend": "bun run --filter frontend preview",
    "preview": "bun run --filter frontend preview",
    "start:old": "bun run src/02-intermediate/05-file-upload.ts",
    "start:file": "bun run",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf apps/*/dist packages/*/dist",
    "install:all": "bun install"
  },
  "devDependencies": {
    "@types/bun": "^1.2.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "elysia": "^1.4.28",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^17.4.2"
  }
}
