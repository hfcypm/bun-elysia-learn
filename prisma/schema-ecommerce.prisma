// Prisma Schema - 电商系统
// 复制命令：cp prisma/schema-ecommerce.prisma prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 分类模型
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  
  @@map("categories")
}

// 商品模型
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int       @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  orderItems  OrderItem[]
  
  @@index([categoryId])
  @@map("products")
}

// 商品图片
model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@map("product_images")
}

// 客户模型
model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String?
  orders   Order[]
  
  @@map("customers")
}

// 订单模型
model Order {
  id         Int        @id @default(autoincrement())
  customerId Int
  customer   Customer   @relation(fields: [customerId], references: [id])
  total      Float
  status     String     @default('pending')  // pending, paid, shipped, completed, cancelled
  items      OrderItem[]
  createdAt  DateTime   @default(now())
  
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// 订单项模型
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // 下单时的价格
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
